OBSION_ENVIRONMENT=development
OBSION_LOG_LEVEL=INFO
OBSION_API_HOST=0.0.0.0
OBSION_API_PORT=58081
OBSION_API_PUBLIC_URL=http://localhost:58081
OBSION_ALLOWED_ORIGINS=["http://localhost:53001"]
OBSION_DATABASE_URL=postgresql+asyncpg://obsion:obsion@localhost:5432/obsion
OBSION_DATABASE_ECHO=false
OBSION_DATABASE_POOL_SIZE=10
OBSION_DATABASE_POOL_MAX_OVERFLOW=20
OBSION_POSTGRES_DB=obsion
OBSION_POSTGRES_USER=obsion
OBSION_POSTGRES_PASSWORD=obsion
OBSION_POSTGRES_PORT=5432
OBSION_REDIS_URL=redis://localhost:56379/0
OBSION_REDIS_PORT=56379
OBSION_OBJECT_STORE_ENDPOINT=http://localhost:59000
OBSION_OBJECT_STORE_ACCESS_KEY=obsion
OBSION_OBJECT_STORE_SECRET_KEY=change-this-local-secret
OBSION_OBJECT_STORE_BUCKET=obsion-artifacts
# Backend selection: auto (memory under TEST, MinIO otherwise), memory, or minio
OBSION_OBJECT_STORE_BACKEND=auto
OBSION_ARTIFACT_MAX_UPLOAD_BYTES=104857600
OBSION_ATTACHMENT_CONTEXT_MAX_CHARS=80000
OBSION_CONVERSATION_CONTEXT_MAX_TURNS=20
OBSION_CONVERSATION_CONTEXT_MAX_CHARS=48000
OBSION_CONVERSATION_CONTEXT_MAX_CHARS_PER_MESSAGE=8000
OBSION_MEMORY_DEFAULT_TTL_DAYS=365
OBSION_MEMORY_MAX_TTL_DAYS=3650
OBSION_MEMORY_MAX_CONTEXT_ITEMS=40
OBSION_MEMORY_MAX_CONTEXT_CHARS=24000
OBSION_MINIO_API_PORT=59000
OBSION_MINIO_CONSOLE_PORT=59001
OBSION_AUTH_MODE=development
OBSION_DEV_ORGANIZATION_ID=00000000-0000-7000-8000-000000000001
OBSION_DEV_USER_ID=00000000-0000-7000-8000-000000000002
OBSION_DEV_BEARER_TOKEN=local-development-only-change-me
OBSION_OIDC_ISSUER=
OBSION_OIDC_AUDIENCE=
OBSION_OIDC_JWKS_URL=
OBSION_OIDC_ALGORITHMS=["RS256","ES256"]
OBSION_AUTH_SESSION_COOKIE_NAME=obsion_session
OBSION_AUTH_SESSION_TTL_SECONDS=28800
OBSION_AUTH_SESSION_RETENTION_DAYS=30
# Locally enrolled password credentials (`obsion provision-user`). Password login is an
# additional credential exchange, not an auth mode: an OIDC deployment can still let the
# administrator who configured that provider sign in. Set enabled=false to refuse local
# passwords entirely. scrypt cost must be a power of two and 128*block_size*cost <= 128MiB.
OBSION_PASSWORD_AUTH_ENABLED=true
OBSION_PASSWORD_MIN_LENGTH=12
OBSION_PASSWORD_MAX_LENGTH=256
OBSION_PASSWORD_MAX_FAILED_ATTEMPTS=5
OBSION_PASSWORD_LOCKOUT_SECONDS=900
OBSION_PASSWORD_SCRYPT_COST=16384
OBSION_PASSWORD_SCRYPT_BLOCK_SIZE=8
OBSION_PASSWORD_SCRYPT_PARALLELISM=1
OBSION_RUN_MAX_STEPS=30
OBSION_RUN_MAX_CRITIC_REPLANS=1
OBSION_RUN_WORKER_CONCURRENCY=8
OBSION_RUN_TIMEOUT_SECONDS=300
OBSION_RUN_CLARIFICATION_TTL_SECONDS=86400
OBSION_EVENT_STREAM_HEARTBEAT_SECONDS=15
OBSION_APP_SERVER_INITIALIZE_TIMEOUT_SECONDS=10
OBSION_APP_SERVER_MAX_MESSAGE_BYTES=262144
OBSION_APP_SERVER_MAX_SUBSCRIPTIONS=32
OBSION_APP_SERVER_EVENT_POLL_INTERVAL_SECONDS=0.25
OBSION_APP_SERVER_IDEMPOTENCY_RETENTION_HOURS=24
OBSION_OPERATOR_CAPABILITY_IDEMPOTENCY_RETENTION_HOURS=168
OBSION_AUTOMATION_ENABLED=true
OBSION_AUTOMATION_WORKER_CONCURRENCY=4
OBSION_AUTOMATION_POLL_INTERVAL_SECONDS=0.5
OBSION_AUTOMATION_LEASE_SECONDS=30
OBSION_ACTIONS_ENABLED=true
OBSION_ACTION_WORKER_CONCURRENCY=2
OBSION_ACTION_POLL_INTERVAL_SECONDS=0.5
OBSION_ACTION_LEASE_SECONDS=30
OBSION_CAPABILITY_RATE_LIMIT_PER_MINUTE=120
OBSION_RATE_LIMIT_FAIL_CLOSED=true
OBSION_SQL_DEFAULT_LIMIT=500
OBSION_SQL_MAX_LIMIT=5000
OBSION_SQL_SCAN_BUDGET=1000000
OBSION_SQL_REQUIRE_EXPLICIT_LIMIT=true
OBSION_SQL_TIMEOUT_SECONDS=30
OBSION_MODEL_REQUEST_TIMEOUT_SECONDS=120
# 按实际模型服务填写允许访问的域名，开源模板默认不允许外部模型请求。
OBSION_MODEL_ALLOWED_HOSTS=[]
OBSION_MODEL_FORCE_PRIVATE_FOR_SENSITIVE=true
OBSION_MODEL_PRIVATE_PROFILE_NAME=private
OBSION_DOCUMENT_MAX_UPLOAD_BYTES=26214400
OBSION_CODE_GRAPH_MAX_FILES=500
OBSION_CODE_GRAPH_MAX_BYTES=8388608
OBSION_KNOWLEDGE_MAX_CANDIDATES=2000
OBSION_KNOWLEDGE_MAX_RESULTS=50
OBSION_KNOWLEDGE_EMBEDDING_PROFILE=
OBSION_KNOWLEDGE_EMBEDDING_BATCH_SIZE=64
OBSION_RUN_MAX_INPUT_TOKENS=120000
OBSION_RUN_MAX_OUTPUT_TOKENS=16000
OBSION_RUN_MAX_COST_AMOUNT=10
OBSION_OTEL_ENABLED=true
OBSION_OTEL_SERVICE_NAME=obsion-control-plane
OBSION_OTEL_EXPORTER_OTLP_ENDPOINT=
OBSION_OTEL_EXPORTER_HEADERS=
OBSION_OTEL_TRACE_SAMPLE_RATIO=1.0
OBSION_SECRET_ENCRYPTION_KEY=
NEXT_PUBLIC_OBSION_API_URL=http://localhost:58081/api/v1
OBSION_WEB_PORT=53001
OBSION_IM_DELIVER=local_outbox
OBSION_IM_INBOX_POLL_INTERVAL_SECONDS=0.25
OBSION_IM_INBOX_LEASE_SECONDS=30
OBSION_IM_INBOX_MAX_ATTEMPTS=5
OBSION_IM_DELIVERY_LEASE_SECONDS=60
OBSION_IM_DELIVERY_MAX_ATTEMPTS=5
OBSION_IM_DELIVERY_BASE_BACKOFF_SECONDS=1
OBSION_IM_DELIVERY_MAX_BACKOFF_SECONDS=60
OBSION_IM_DELIVERY_RATE_LIMIT_PER_MINUTE=120
OBSION_IM_WEBHOOK_SECRET=
OBSION_IM_TLS_CERT=
OBSION_IM_TLS_KEY=
OBSION_IM_PUBLIC_HOSTS=
OBSION_FEISHU_APP_ID=
OBSION_FEISHU_APP_SECRET=
OBSION_FEISHU_ENCRYPT_KEY=
OBSION_FEISHU_VERIFICATION_TOKEN=
OBSION_FEISHU_LIVE_CHAT_ID=
OBSION_LIVE_PROFILE=
# Opt-in backup/restore drills (throwaway local PostgreSQL and MinIO containers)
OBSION_DR_DRILL=
OBSION_CONFLUENCE_EMAIL=
OBSION_CONFLUENCE_API_TOKEN=
# Required by obsion-im --channel dingtalk stream. Install the
# obsion-im[dingtalk-stream] extra in the adapter deployment; inject values from
# the runtime secret manager, never this file.
OBSION_DINGTALK_APP_KEY=
OBSION_DINGTALK_APP_SECRET=
# Durable single-recipient DingTalk robot delivery is disabled until an
# administrator activates the connector and binds the capability.
OBSION_DINGTALK_UNIFIED_APP_ID=
OBSION_DINGTALK_ROBOT_CODE=
OBSION_DINGTALK_OUTBOX_ENABLED=false
OBSION_DINGTALK_OUTBOX_POLL_INTERVAL_SECONDS=1.0
OBSION_DINGTALK_OUTBOX_LEASE_SECONDS=60
OBSION_DINGTALK_OUTBOX_MAX_ATTEMPTS=3
# 阿里云云效配置
OBSION_CODEUP_APP_ID=
OBSION_CODEUP_ORG_ID=
OBSION_YUNXIAO_PAT=
# Opt-in live Yunxiao repository probe (never set in committed files)
OBSION_YUNXIAO_LIVE=
OBSION_YUNXIAO_ENDPOINT=https://openapi-rdc.aliyuncs.com
OBSION_YUNXIAO_ORGANIZATION_IDS=
OBSION_WECOM_CORP_ID=
OBSION_WECOM_CORP_SECRET=
OBSION_WECOM_AGENT_ID=
OBSION_WECOM_TOKEN=
OBSION_WECOM_ENCODING_AES_KEY=
# Optional operator-provided OpenAI-compatible endpoint bootstrap inputs. The API key
# remains a process credential referenced as env://OBSION_AI_API_KEY; it is never stored
# in the database, AgentSpec, Event, Evidence, or browser-visible configuration.
OBSION_AI_BASE_URL=
OBSION_AI_API_KEY=
OBSION_AI_MODEL=
