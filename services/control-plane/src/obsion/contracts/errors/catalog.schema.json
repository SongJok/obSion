{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obsion.dev/contracts/errors/catalog.schema.json",
  "title": "Obsion Domain Error Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "codes"],
  "properties": {
    "catalog_version": {"const": 1},
    "codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "category", "http_status", "description"],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "category": {
            "enum": [
              "authorization",
              "conflict",
              "not_found",
              "validation",
              "rate_limit",
              "dependency",
              "internal",
              "execution"
            ]
          },
          "http_status": {
            "oneOf": [
              {"type": "integer", "minimum": 400, "maximum": 599},
              {"type": "null"}
            ]
          },
          "description": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    }
  }
}
