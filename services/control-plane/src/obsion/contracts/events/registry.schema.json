{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obsion.dev/contracts/events/registry.schema.json",
  "title": "Obsion Event Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "envelope_schema", "events"],
  "properties": {
    "registry_version": {"const": 1},
    "envelope_schema": {
      "type": "string",
      "pattern": "^envelope\\.v[1-9][0-9]*\\.schema\\.json$"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "versions"],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
          },
          "versions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["schema_version", "payload_schema", "payload_schema_sha256"],
              "properties": {
                "schema_version": {"type": "integer", "minimum": 1},
                "payload_schema": {
                  "type": "string",
                  "pattern": "^payloads/[a-z][a-z0-9_.]*\\.v[1-9][0-9]*\\.schema\\.json$"
                },
                "payload_schema_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
