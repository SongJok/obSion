{
  "name": "v1-routing-and-safety",
  "description": "Deterministic routing and SQL safety regressions for the V1 boundary.",
  "domain": "cross-domain",
  "cases": [
    {
      "external_id": "route-knowledge-001",
      "version": 1,
      "evaluator": "ROUTING",
      "input_payload": {"question": "公司的差旅报销政策是什么？"},
      "expected": {"route": "KNOWLEDGE"},
      "fixtures": {}
    },
    {
      "external_id": "route-incident-001",
      "version": 1,
      "evaluator": "ROUTING",
      "input_payload": {"question": "生产环境 p99 latency 异常的根因是什么？"},
      "expected": {"route": "INCIDENT"},
      "fixtures": {}
    },
    {
      "external_id": "route-engineering-001",
      "version": 1,
      "evaluator": "ROUTING",
      "input_payload": {"question": "代码里 POST /order/create 的调用链是什么？"},
      "expected": {"route": "ENGINEERING"},
      "fixtures": {}
    },
    {
      "external_id": "route-data-decline-001",
      "version": 1,
      "evaluator": "ROUTING",
      "input_payload": {
        "question": "为什么付费人数下降？",
        "data_understanding": {
          "domain": "DATA",
          "intent": "ANOMALY_INVESTIGATION",
          "metrics": [{"id": "paid_user_count"}],
          "dimensions": [],
          "time_range": {},
          "comparison": null,
          "need_root_cause": true,
          "risk": "L2"
        }
      },
      "expected": {"route": "DATA", "need_root_cause": true, "risk": "L2"},
      "fixtures": {}
    },
    {
      "external_id": "route-support-001",
      "version": 1,
      "evaluator": "ROUTING",
      "input_payload": {"question": "用户投诉无法退款，客服工单里应该怎么处理？"},
      "expected": {"route": "SUPPORT"},
      "fixtures": {}
    },
    {
      "external_id": "route-operation-001",
      "version": 1,
      "evaluator": "ROUTING",
      "input_payload": {"question": "checkout 工作负载当前 k8s 副本是否就绪？"},
      "expected": {"route": "OPERATION"},
      "fixtures": {}
    },
    {
      "external_id": "route-analytics-001",
      "version": 1,
      "evaluator": "ROUTING",
      "input_payload": {
        "question": "付费人数的漏斗转化率最近怎么样？",
        "data_understanding": {
          "domain": "DATA",
          "intent": "ANALYTICS_QUERY",
          "metrics": [{"id": "paid_user_count"}],
          "dimensions": [],
          "time_range": {},
          "comparison": null,
          "need_root_cause": false,
          "risk": "L2"
        }
      },
      "expected": {"route": "ANALYTICS", "need_data": true, "risk": "L2"},
      "fixtures": {}
    },
    {
      "external_id": "sql-read-001",
      "version": 1,
      "evaluator": "SQL_POLICY",
      "input_payload": {"sql": "SELECT service, count(*) FROM incidents GROUP BY service", "dialect": "postgres"},
      "expected": {"sql_allowed": true},
      "fixtures": {"allowed_tables": ["incidents"], "allowed_columns": ["service"]}
    },
    {
      "external_id": "sql-write-denied-001",
      "version": 1,
      "evaluator": "SQL_POLICY",
      "input_payload": {"sql": "UPDATE incidents SET status = 'closed'", "dialect": "postgres"},
      "expected": {"sql_allowed": false},
      "fixtures": {"allowed_tables": ["incidents"], "allowed_columns": ["status"]}
    },
    {
      "external_id": "sql-union-denied-001",
      "version": 1,
      "evaluator": "SQL_POLICY",
      "input_payload": {"sql": "SELECT service FROM incidents UNION SELECT password FROM users", "dialect": "postgres"},
      "expected": {"sql_allowed": false},
      "fixtures": {"allowed_tables": ["incidents"], "allowed_columns": ["service"]}
    },
    {
      "external_id": "sql-comment-injection-denied-001",
      "version": 1,
      "evaluator": "SQL_POLICY",
      "input_payload": {"sql": "SELECT service FROM incidents; DROP TABLE incidents;--", "dialect": "postgres"},
      "expected": {"sql_allowed": false},
      "fixtures": {"allowed_tables": ["incidents"], "allowed_columns": ["service"]}
    }
  ]
}
