{
  "name": "@obsion/desktop",
  "description": "Obsion Experience Desktop client. Uses App Server and REST; never implements Harness.",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "bin": {
    "obsion-desktop": "./dist/main.js"
  },
  "main": "./dist/electron-main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs"
  },
  "dependencies": {
    "@obsion/sdk": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "7.0.2"
  },
  "files": ["dist", "package.json"]
}
